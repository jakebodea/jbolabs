---
/**
 * Page shell: head tags (title, description, canonical, Open Graph,
 * structured data), fonts, header and footer, the referral-link memory, and
 * Cloudflare Web Analytics on prod.
 */
import "@/styles/global.css";

import { Font } from "astro:assets";
import { documentTitle, metaDescription } from "@jakebodea/cloudflare-kit/seo";

import WebAnalyticsBeacon from "@jakebodea/cloudflare-kit/astro/web-analytics-beacon.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import StructuredData from "@/components/structured-data.astro";
import { footerNav, primaryNav } from "@/content/navigation";
import { site } from "../../site.config";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string | undefined;
  description?: string | undefined;
  robots?: string | undefined;
}

const { description, robots, title } = Astro.props;

const origin = Astro.site?.origin ?? Astro.url.origin;
const fullTitle = title === undefined ? `${site.name} | ${site.titleSuffix}` : documentTitle(title, site.shortName);
// Keeps every snippet within what search engines show.
const pageDescription = metaDescription(description ?? site.description, site.descriptionContext);
const canonical = `${origin}${Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/u, "")}`;
const ogImage = `${origin}/og-default.png?v=20261006`;
// `--background` in global.css as hex, for browser chrome that can't read CSS.
const themeColor = { dark: "#2c2e31", light: "#ffffff" };

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <!--
      Pick light or dark before first paint: a saved choice wins, else the system
      setting. Both theme-color tags then follow the `.dark` class, so a saved
      choice that differs from the system still colors the browser chrome.
    -->
    <script is:inline define:vars={{ themeColor }}>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle("dark", dark);
        const syncThemeColor = () => {
          const color = root.classList.contains("dark") ? themeColor.dark : themeColor.light;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.content = color;
          }
        };
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(root, { attributeFilter: ["class"] });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="JBO Labs — great websites, shipped fast." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="JBO Labs — great websites, shipped fast." />
    <link rel="icon" href="/favicon.png?v=20261006" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261006" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-wordmark" preload />
    <Font cssVariable="--font-label" />
    <StructuredData origin={origin} />
  </head>
  <body class="flex min-h-svh flex-col">
    <!-- Edge strips that iOS Safari samples to tint its status bar and toolbar (global.css). -->
    <div class="safari-edge safari-edge-top" aria-hidden="true"></div>
    <div class="safari-edge safari-edge-bottom" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-background focus:px-4 focus:py-2 focus:shadow">Skip to content</a>
    <SiteHeader title={site.name} items={primaryNav} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter title={site.name} tagline={site.tagline} items={footerNav} />
    <WebAnalyticsBeacon />
    <script>
      import "@/scripts/referral";
    </script>
  </body>
</html>
