---
/** Questions as native <details> disclosures: accessible and JavaScript-free. */

import Headline from "@/components/headline.astro";
import type { FaqSection } from "@/content/types";

interface Props {
  value: FaqSection;
}

const { value } = Astro.props;
---

<section id="faq" class="container-page py-20 sm:py-28">
  <div class="grid gap-10 md:grid-cols-[1fr_1.5fr] md:gap-16">
    <h2 class="display text-4xl leading-[1.08] sm:text-5xl"><Headline text={value.headline} /></h2>
    <div class="divide-y divide-border border-y border-border">
      {value.items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-medium tracking-[-0.015em] [&::-webkit-details-marker]:hidden">
            {item.question}
            <span class="relative size-3 shrink-0 text-muted-foreground" aria-hidden="true">
              <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current"></span>
              <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-current transition-transform duration-200 group-open:rotate-90"></span>
            </span>
          </summary>
          <p class="max-w-xl pb-6 leading-relaxed text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /*
   * The answer opens and closes with the plus icon instead of snapping. Browsers
   * without `::details-content` keep the instant toggle. The negative margin
   * tucks the answer under the question (it lives here, not on the <p>, so the
   * clipped box does not cut the text).
   */
  details::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height 250ms var(--ease-out-expo),
      margin 250ms var(--ease-out-expo),
      opacity 200ms ease-out,
      content-visibility 250ms allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    margin-top: -0.5rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition:
        opacity 150ms ease-out,
        content-visibility 150ms allow-discrete;
    }
  }
</style>
